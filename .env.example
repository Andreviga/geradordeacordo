# Copie este arquivo para .env.local e preencha os valores antes de usar vercel dev.
# NUNCA comite .env.local no repositório.

# ── Autenticação ─────────────────────────────────────────────────────────────
# JWT_SECRET: segredo para assinar tokens. Gere com: openssl rand -hex 32
JWT_SECRET=

# APP_PASSWORD_HASH: hash bcrypt da senha da secretaria. Gere com: npm run hash
APP_PASSWORD_HASH=

# ── Assinatura digital ────────────────────────────────────────────────────────
# A assinatura e feita no portal gov.br pelos proprios signatarios. Nao ha
# variavel a configurar: o sistema so valida o PDF, calcula o SHA-256 e monta as
# instrucoes. As variaveis de ZapSign e Adobe Sign foram removidas junto com
# essas integracoes — se ainda estiverem no painel do Vercel, apague.

# ── Backup ────────────────────────────────────────────────────────────────────
# Dois destinos possiveis; basta um. Os dois juntos tambem funcionam.
#
# 1) E-mail: funciona em qualquer conta Google. O anexo vai SEMPRE cifrado.
BACKUP_EMAIL=
# Obrigatoria quando BACKUP_EMAIL esta definida. Gere com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# GUARDE FORA DO VERCEL: sem ela o backup nao e recuperavel.
BACKUP_SENHA=
#
# 2) Drive: exige Drive COMPARTILHADO (Workspace Business Standard ou superior).
#    Service account nao tem cota, entao pasta em "Meu Drive" nao funciona.
DRIVE_BACKUP_FOLDER_ID=

# ── Google Drive (server-side, para idempotência e PDFs assinados) ────────────
# Conta de serviço GCP com escopo drive ou drive.file.
# 1. Crie SA em console.cloud.google.com → IAM & Admin → Service Accounts
# 2. Gere chave JSON → cole o conteúdo todo como valor desta variável
# 3. Compartilhe a pasta do Drive com o e-mail da SA (ex: sa@projeto.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID da pasta do Drive onde salvar PDFs assinados (URL: drive.google.com/drive/folders/ID)
DRIVE_PDF_FOLDER_ID=


# ── Segurança adicional ───────────────────────────────────────────────────────
# Origem autorizada (URL do Vercel sem barra final). Deixe vazio em dev local.
# Exemplo: https://geradordeacordo.vercel.app
ALLOWED_ORIGIN=

# ── Scripts de manutenção ─────────────────────────────────────────────────────
# Hostname do banco de testes (sem https://, sem porta, sem barra).
# Usado por db:limpar-testes (recusa se DATABASE_URL aponta para outro host),
# db:migrate (avisa e pede confirmação) e smoke (recusa se host diferente).
# Copie o hostname da connection string do branch de testes.
BANCO_TESTE_HOST=
# Connection string do Neon PostgreSQL.
# Copie de: painel Neon → projeto → Connection Details → "Connection string"
DATABASE_URL=

# ── E-mail de lembretes (Fase E, Etapa 5) ────────────────────────────────────
# Seleciona o adapter de e-mail. Para trocar: crie api/cron/_email_<nome>.js.
EMAIL_PROVIDER=gmail
# Conta Gmail com senha de app. Gere em: myaccount.google.com → Segurança → Senhas de app
# Porta 587 STARTTLS (smtp.gmail.com). OAuth NÃO necessário com senha de app.
SMTP_USER=notificacoesraizes@gmail.com
SMTP_PASS=
# Endereço que aparece no campo "De:" dos lembretes enviados
EMAIL_FROM=Colégio Raízes <notificacoesraizes@gmail.com>
# Secret para autenticar chamadas do Vercel Cron ao endpoint /api/cron/lembretes
# Gere com: openssl rand -hex 32
CRON_SECRET=
