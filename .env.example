# Copie este arquivo para .env.local e preencha os valores antes de usar vercel dev.
# NUNCA comite .env.local no repositório.

# Adobe Acrobat Sign — obrigatório para assinatura eletrônica via Adobe
ADOBE_SIGN_INTEGRATION_KEY=
ADOBE_SIGN_REGION=na4

# Token de acesso compartilhado cliente↔servidor.
# Gere com: openssl rand -hex 32
# Configure o mesmo valor em: (1) esta variável de ambiente, (2) constante APP_TOKEN em index.html
APP_ACCESS_TOKEN=

# Origem autorizada (URL do Vercel, sem barra final). Deixe vazio em dev local.
# Exemplo: https://geradordeacordo.vercel.app
ALLOWED_ORIGIN=

# Provedor de assinatura padrão (manual | adobe)
# Padrão: manual — nunca fica sem caminho de assinatura
ASSINATURA_PROVIDER=manual
