# Copie este arquivo para .env.local e preencha os valores antes de usar vercel dev.
# NUNCA comite .env.local no repositório.

# ── Autenticação ─────────────────────────────────────────────────────────────
# JWT_SECRET: segredo para assinar tokens. Gere com: openssl rand -hex 32
JWT_SECRET=

# APP_PASSWORD_HASH: hash bcrypt da senha da secretaria. Gere com: npm run hash
APP_PASSWORD_HASH=

# ── Assinatura digital ────────────────────────────────────────────────────────
# Provedor ativo. Padrão: manual (nunca fica sem caminho de assinatura).
# Valores aceitos: manual | zapsign | adobe
ASSINATURA_PROVIDER=manual

# ZapSign — obrigatório se ASSINATURA_PROVIDER=zapsign
ZAPSIGN_API_TOKEN=
# Segredo para validar webhooks da ZapSign (configure também no painel ZapSign)
ZAPSIGN_WEBHOOK_SECRET=

# Adobe Sign — obrigatório se ASSINATURA_PROVIDER=adobe (requer conta Enterprise)
ADOBE_SIGN_INTEGRATION_KEY=
ADOBE_SIGN_REGION=na4

# ── Segurança adicional ───────────────────────────────────────────────────────
# Origem autorizada (URL do Vercel sem barra final). Deixe vazio em dev local.
# Exemplo: https://geradordeacordo.vercel.app
ALLOWED_ORIGIN=
